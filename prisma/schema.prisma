// Herbl Management App — data model
// Docs: https://pris.ly/d/prisma-schema
//
// ⚠️ orgId is `String?` (nullable) here ON PURPOSE, but every tenant table's orgId column is
// NOT NULL at the database level (locked by migration 20260727000000_orgid_notnull_drop_dead_cols).
// The field stays nullable in this schema so the auto-stamping client (lib/db.ts stampData) can
// omit orgId from create() inputs — making it required here would force orgId into every create
// call site, including nested ones. Production only ever runs `prisma migrate deploy`, which applies
// migration files and never diffs against this schema, so the DB constraint is safe permanently.
// CAVEAT for whoever generates the NEXT migration: `prisma migrate diff`/`migrate dev` will see this
// divergence and emit spurious `ALTER COLUMN "orgId" DROP NOT NULL` lines — delete those hunks.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A customer account (tenant). Every piece of business data belongs to exactly one Organization.
/// This is the backbone of multi-tenancy: one shared database, each row tagged with its owner.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // --- Company profile: printed on POs and shown in the app chrome (replaces the old hardcoded constant) ---
  legalName String? // legal entity name for documents (falls back to name)
  address   String? // multiline company address
  email     String?
  phone     String?
  // --- Branding. Two different marks: a wide logo for documents, a square one for the app. ---
  logoUrl   String? // wide logo printed at the top of purchase orders
  iconUrl   String? // square mark shown beside the company name in the switcher
  brandInk  String  @default("#1f2937") // headings, the dark bar, and totals on a PO
  brandBand String  @default("#eef2f7") // the light header band behind the logo on a PO
  // --- Money / locale formatting, so non-US customers aren't stuck with "$" ---
  currencyCode   String @default("USD")
  currencySymbol String @default("$")
  locale         String @default("en-US")
  // Soft delete: set when the owner deletes the company. It goes dark immediately and is purged
  // for good after a grace period (see the scheduler). Null = active.
  deactivatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facilities              Facility[]
  suppliers               Supplier[]
  products                Product[]
  skuSnapshots            SkuSnapshot[]
  dismissedNotifications  DismissedNotification[]
  inventoryValueSnapshots InventoryValueSnapshot[]
  settings                Settings[]
  channelListings         ChannelListing[]
  channelStock            ChannelStock[]
  salesOrders             SalesOrder[]
  salesOrderLines         SalesOrderLine[]
  materialTypes           MaterialType[]
  purchaseInvoices        PurchaseInvoice[]
  purchases               Purchase[]
  lots                    Lot[]
  documents               Document[]
  purchaseOrders          PurchaseOrder[]
  transactionInvoices     TransactionInvoice[]
  transactions            Transaction[]
  memberships             Membership[]
  invites                 Invite[]
  lotLines                LotLine[]
  lotMaterials            LotMaterial[]
  purchaseOrderLines      PurchaseOrderLine[]
  stockMovements          StockMovement[]
  integrations            Integration[]
}

/// A tenant's connection to an external sales platform (Amazon, Shopify, TikTok Shop). Holds the
/// per-seller OAuth credential (refresh token, ENCRYPTED at rest — never plaintext) plus the
/// marketplace/region needed to call that platform's API. One row per (org, provider). The app's
/// own OAuth app id/secret stay in env; only the seller-specific token lives here.
model Integration {
  id           String        @id @default(cuid())
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider     String // "amazon" | "shopify" | "tiktok"
  status       String        @default("connected") // connected | error | revoked
  // Encrypted refresh token (see lib/secret-box.ts). Null until the OAuth callback completes.
  refreshTokenEnc String?
  // Encrypted short-lived access token + its expiry, for platforms whose access tokens outlive a
  // single request (TikTok: ~7 days) — cached so every call doesn't burn a refresh. Amazon keeps
  // its per-request LWA tokens in memory and Shopify's offline token never expires; both stay null.
  accessTokenEnc       String?
  accessTokenExpiresAt DateTime?
  sellerId        String? // platform's account id (Amazon selling-partner id, Shopify shop, TikTok shop id)
  marketplaceId   String? // Amazon: e.g. ATVPDKIKX0DER (US); TikTok: the shop_cipher for shop-scoped calls
  region          String? // Amazon: na | eu | fe (endpoint group); TikTok: shop region (e.g. US)
  scope           String? // granted OAuth scopes, if the platform returns them
  connectedAt     DateTime?
  lastSyncAt      DateTime?
  lastError       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([orgId, provider])
}

/// Links a Clerk user account to an Organization (which company they belong to + their role).
/// Clerk owns identity ("who you are"); this table owns tenancy ("which company you're in").
model Membership {
  id           String       @id @default(cuid())
  clerkUserId  String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  role         String       @default("owner") // owner | member
  // Per-resource action grants for a member, e.g. { "lots": ["view","create"], ... }. Null = the
  // default member baseline (see lib/permissions.ts). Owners ignore this and always have full access.
  permissions  Json?
  createdAt    DateTime     @default(now())

  @@unique([clerkUserId, orgId])
  @@index([clerkUserId])
}

/// A pending invitation to join an Organization. The token in the link is the credential, so the
/// accept path looks it up on the UNSCOPED client — the invitee has no organization yet, and the
/// whole point is to give them one.
model Invite {
  id           String       @id @default(cuid())
  // Optional to match every other tenant table: the scoping extension supplies orgId on write,
  // so a required relation would force it into every call site's type and defeat the point.
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String?
  email        String // who it was meant for; shown to the owner, not enforced on accept
  token        String       @unique // random, unguessable — this is what authorises joining
  role         String       @default("member") // owner | member
  invitedBy    String? // clerkUserId of whoever sent it
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedBy   String? // clerkUserId that used it

  @@index([orgId])
}

/// A place inventory lives or is produced: a co-packer, your own warehouse, or a 3PL you
/// simply ship to. Customer-managed from the Facilities tab (may also double as a supplier).
model Facility {
  id              String          @id @default(cuid())
  orgId           String?
  organization    Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  code            String
  name            String
  type            String          @default("co-packer") // co-packer | warehouse | 3pl | other | channel
  channel         String? // set when this facility mirrors a connected sales channel (AMAZON_FBA, AMAZON_AWD, SHOPIFY, TIKTOK)
  locked          Boolean         @default(false) // managed by an integration — not editable or deletable in-app
  // The integration's own id for this place (e.g. a Shopify location gid). Matching on it means a
  // rename on the platform updates this facility instead of spawning a duplicate.
  externalId      String?
  // The platform stopped reporting this place (location deactivated or deleted). Kept — it may
  // carry lots and movements — but no longer synced, and hidden from pickers for NEW activity.
  inactive        Boolean         @default(false)
  legalName       String? // vendor name printed on POs (falls back to name)
  address         String? // multiline vendor address for POs
  notes           String?
  lots            Lot[]
  purchases       Purchase[]
  purchaseOrders  PurchaseOrder[]
  supplierProfile Supplier?
  channelStock    ChannelStock[]
  movementsOut    StockMovement[] @relation("MovementFrom")
  movementsIn     StockMovement[] @relation("MovementTo")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([orgId, code])
  @@index([orgId, externalId])
}

/// A movement of stock out of one of your locations — either a transfer to another of your
/// facilities, or out of your network. Covers BOTH finished goods and raw materials.
/// Production (finished) and purchases (raw) are how stock enters; movements are how it leaves.
/// Exactly one of `toFacilityId` / `toDestination` is set. Raw materials may only go to another
/// facility or LOSS — never to a sales channel or customer.
model StockMovement {
  id             String        @id @default(cuid())
  orgId          String?
  organization   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  itemType       String        @default("FINISHED") // FINISHED | RAW
  // FINISHED: the SKU moved. RAW sku-specific (e.g. printed pouches): the SKU whose pool this draws.
  product        Product?      @relation(fields: [productId], references: [id])
  productId      String?
  // RAW: the material moved.
  materialType   MaterialType? @relation(fields: [materialTypeId], references: [id])
  materialTypeId String?
  quantity       Float // units moved (always positive; Float so weight/volume works too)
  date           DateTime
  fromFacility   Facility      @relation("MovementFrom", fields: [fromFacilityId], references: [id])
  fromFacilityId String
  toFacility     Facility?     @relation("MovementTo", fields: [toFacilityId], references: [id])
  toFacilityId   String? // set for a transfer between your own facilities
  toDestination  String? // set when stock leaves your network: AMAZON | SHOPIFY | TIKTOK | CUSTOMER | LOSS
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([productId, date])
  @@index([materialTypeId, date])
  @@index([fromFacilityId])
}

/// A vendor we pay (may also be a facility, matched loosely by name).
model Supplier {
  id                  String               @id @default(cuid())
  orgId               String?
  organization        Organization?        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name                String              
  photoUrl            String?
  email               String?
  phone               String?
  address             String?
  notes               String?
  facility            Facility?            @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  facilityId          String?              @unique // set when this supplier IS one of our facilities
  purchases           Purchase[]
  transactions        Transaction[]
  transactionInvoices TransactionInvoice[]
  purchaseInvoices    PurchaseInvoice[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([orgId, name])
}

/// Finished product (SKU). e.g. LKD = Liver and Kidney Detox Tea
model Product {
  id                 String              @id @default(cuid())
  orgId              String?
  organization       Organization?       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  code               String             
  name               String
  imageUrl           String?
  notes              String?
  barcode            String? // UPC / EAN / GTIN — the identifier shared across every channel
  // --- Amazon mapping (drives the FBA/restock dashboard sync) ---
  asin               String? // Amazon ASIN, e.g. B0DQ62R6Q3
  sellerSku          String? // Amazon Seller SKU, e.g. QC-6LN8-7BT8
  fnsku              String? // Amazon FNSKU
  // --- Shopify mapping (identifiers only for now; live sync comes later) ---
  shopifyProductId   String?
  shopifyVariantId   String?
  shopifySku         String?
  // --- TikTok Shop mapping (identifiers only for now; live sync comes later) ---
  tiktokProductId    String?
  tiktokSku          String?
  // --- Per-SKU restock policy (null = use the global default) ---
  minMonths          Float? // floor: months of stock to never fall below
  leadMonths         Float? // production only: placing a run → finished units in hand
  shipDays           Int? // per-SKU shipping time override, in days
  // Null on all three means "use the global default" — the column default was dropped so new
  // products inherit changes to the org setting instead of being frozen at whatever it was.
  reorderToMonths    Float? // order size: months of sales per run
  batchSize          Int? // co-packer minimum / standard run size; null = don't round the order
  sortIndex          Int? // manual sort position on the inventory dashboard
  windowDays         Int? // per-SKU velocity window override (10/30/90); null = use the global toggle
  excludeDays        Int? // drop the most recent X (OOS) days from the velocity window
  lotLines           LotLine[]
  purchases          Purchase[]
  lotMaterials       LotMaterial[]
  purchaseOrderLines PurchaseOrderLine[]
  snapshots          SkuSnapshot[]
  channelStock       ChannelStock[]
  salesOrderLines    SalesOrderLine[]
  movements          StockMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([orgId, code])
}

/// A point-in-time capture of a SKU's Amazon FBA position + trailing sales, pulled from SP-API.
model SkuSnapshot {
  id               String        @id @default(cuid())
  orgId            String?
  organization     Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  capturedAt       DateTime      @default(now())
  fbaAvailable     Int           @default(0) // fulfillable
  fbaInbound       Int           @default(0) // working + shipped + receiving
  fbaReserved      Int           @default(0) // reserved + in-transit-between-FCs + researching
  fbaUnfulfillable Int           @default(0)
  fbaTotal         Int           @default(0)
  awdOnhand        Int           @default(0) // Amazon Warehousing & Distribution on-hand
  awdInbound       Int           @default(0) // inbound to AWD
  inStock          Boolean       @default(true) // was the SKU in stock at capture (for future exact velocity)
  dailySales       Json? // { "YYYY-MM-DD": units } over the trailing 90 days, for custom/exclude windows
  salesEnd         DateTime? // the window end anchor (sync time − 2d lag) the daily series is measured to
  units10d         Int           @default(0)
  units30d         Int           @default(0)
  units90d         Int           @default(0)
  salesDays10      Int           @default(0) // days with ≥1 sale in the trailing 10/30/90 days
  salesDays30      Int           @default(0)
  salesDays90      Int           @default(0)

  @@index([productId, capturedAt])
}

/// Dashboard notifications the user manually dismissed. Pruned automatically once the
/// underlying condition resolves, so a recurring alert reappears fresh.
model DismissedNotification {
  id          String        @id @default(cuid())
  key          String // stable alert key, e.g. "reorder:LDX" | "material:TEABAG"
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  dismissedAt  DateTime      @default(now())

  @@unique([orgId, key])
}

/// One row per day: the total inventory value split by bucket, for the evolution chart.
/// Captured going forward (upserted per calendar day) — the live total is already de-duplicated,
/// so each daily point is internally consistent with no double-counting across buckets.
model InventoryValueSnapshot {
  id           String        @id @default(cuid())
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  day          String        // "YYYY-MM-DD"
  capturedAt   DateTime      @default(now())
  raw          Float
  inProduction Float
  fba          Float
  awd          Float
  atLocations  Float         @default(0) // finished goods held at your own facilities / 3PLs
  total        Float

  @@unique([orgId, day])
}

/// Singleton global restock defaults, editable in-app. Per-SKU values override these.
model Settings {
  id                String        @id @default(cuid())
  orgId             String?
  organization      Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  defaultMinMonths  Float         @default(5) // months of stock to never fall below
  defaultLeadMonths Float         @default(4.5) // production only: placing a run → units in hand
  /// Deprecated: superseded by shipDays. Kept because dropping a column would need
  /// --accept-data-loss, which the deploy's own `db push` can't pass either.
  shipMonths        Float         @default(1)
  // Moving finished stock you already own onto the channel. Days, not months — it's a truck, not
  // a production run, and rounding a fortnight to "0.5 months" reads as a guess.
  shipDays          Int           @default(30)
  // How much cover the channel should still hold when you start shipping, as a multiple of the
  // shipping time. 3× with 15-day shipping = start moving stock once the channel is under 45 days.
  shipBufferX       Float         @default(3)
  // Months of sales per production run — a fixed size, not a top-up to a level.
  // Per-SKU `reorderToMonths` overrides it.
  defaultReorderTo  Float         @default(8)
  // Round every order up to a multiple of this. 0 = order any quantity. Per-SKU `batchSize` wins.
  defaultBatchSize  Int           @default(0)
  sortMode          String        @default("sales") // inventory dashboard sort: sales | available | manual
  // Order sources to drop from Shopify totals so channel-mirrored orders (e.g. TikTok selling
  // through Shopify) aren't counted twice. Values are Shopify `source` keys, e.g. ["tiktok"].
  excludedShopifySources String[]  @default([])
  // Labels of the "key documents" every lot is expected to carry (e.g. BOL, COA). Each shows as a
  // pill on the lots table — purple when a matching-label document is attached, grey when missing.
  // Operator-editable per org; empty = the Documents column shows nothing.
  keyDocuments      String[]      @default([])
  // --- Automatic daily Amazon sync + inventory-value snapshot ---
  syncEnabled       Boolean       @default(true)
  syncHour          Int           @default(5) // hour-of-day to run (in syncTz)
  syncMinute        Int           @default(0)
  syncTz            String        @default("America/Argentina/Buenos_Aires")
  lastSyncRun       String? // last completed run, "YYYY-MM-DD" in syncTz (idempotency guard)
  lastSyncAt        DateTime? // exact timestamp of the last completed run
  // Editable dashboard: [{ id, x, y, w, h }] of placed widgets (12-col grid). null = default layout.
  dashboardLayout   Json?

  @@unique([orgId])
}

/// Extensible raw-material catalog (Tea Bag, Pouch, ...).
/// poolKey decides how FIFO stock is segmented.
model MaterialType {
  id                String            @id @default(cuid())
  orgId             String?
  organization      Organization?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  code              String            // TEABAG | POUCH | ...
  name              String
  unitLabel         String            @default("unit") // "bag", "pouch"
  defaultPerUnit    Float             @default(1) // default consumed per finished unit
  poolKey           String            @default("FACILITY") // FACILITY | FACILITY_SKU
  skuSpecific       Boolean           @default(false) // purchases & pools are per-SKU
  lowStockThreshold Float? // dashboard notifies when available qty drops below this (null = off)
  imageUrl          String?
  purchases         Purchase[]
  purchaseInvoices  PurchaseInvoice[]
  lotMaterials      LotMaterial[]
  movements         StockMovement[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([orgId, code])
}

/// One real purchase payment (a single material), fanning out into per-facility/SKU lines.
model PurchaseInvoice {
  id             String        @id @default(cuid())
  orgId          String?
  organization   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])
  supplierId     String?
  materialType   MaterialType  @relation(fields: [materialTypeId], references: [id])
  materialTypeId String
  date           DateTime
  invoiceTotal   Float         @default(0)
  isAdjustment   Boolean       @default(false) // lost-inventory invoice
  notes          String?
  documentUrl    String? // legacy single-doc field (superseded by documents[])
  documents      Document[]
  lines          Purchase[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

/// A raw-material purchase line. Feeds the FIFO pools.
model Purchase {
  id             String           @id @default(cuid())
  orgId          String?
  organization   Organization?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice        PurchaseInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String?
  materialType   MaterialType     @relation(fields: [materialTypeId], references: [id])
  materialTypeId String
  date           DateTime
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  supplierId     String?
  facility       Facility         @relation(fields: [facilityId], references: [id])
  facilityId     String
  // Only set for SKU-specific materials (e.g. pouches): which SKU this stock is for.
  product        Product?         @relation(fields: [productId], references: [id])
  productId      String?
  quantity       Float
  unitCost       Float
  total          Float
  seq            Int              @default(0) // stable FIFO tie-break within same date
  // "Lost inventory" / corrections: a supply adjustment, not consumed demand.
  isAdjustment   Boolean          @default(false)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([materialTypeId, facilityId, productId, date])
}

enum LotStatus {
  IN_PRODUCTION
  FINISHED
}

/// A production batch / PO.
model Lot {
  id                 String         @id @default(cuid())
  orgId              String?
  organization       Organization?  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  poNumber           String? // e.g. "#7-CCP"
  lotNr              Int // numeric LOT NR used by transactions
  poDate             DateTime?
  facility           Facility       @relation(fields: [facilityId], references: [id])
  facilityId         String
  status             LotStatus      @default(IN_PRODUCTION)
  // Whether the supplier has been fully paid for this lot: PAID | DUE. Operator-set, independent
  // of production status — a batch can be finished and unpaid, or paid upfront while in production.
  paymentStatus      String         @default("DUE")
  finishedAt         DateTime? // set each time status flips to FINISHED (latest wins; kept if later unmarked)
  expiryAt           DateTime? // expiry of the finished goods — entered when the lot is FINISHED
  batchNr            String? // production batch number printed on the finished goods
  notes              String?
  // Informational only (NOT part of COG): what was actually paid inbound.
  inboundPaidTotal   Float?
  inboundPaidPerUnit Float?
  lines              LotLine[]
  transactions       Transaction[]
  purchaseOrder      PurchaseOrder?
  documents          Document[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([lotNr])
}

/// An uploaded document (COA, BOL, invoice, …). Attaches to exactly one parent:
/// a lot, a transaction invoice, or a purchase invoice. Parents can hold many;
/// the same physical file may be uploaded to several parents (an invoice that
/// spans multiple transactions). Table kept as "LotDocument" for continuity.
model Document {
  id                   String              @id @default(cuid())
  orgId                String?
  organization         Organization?       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  label                String? // free text; e.g. "COA", "BOL", "Invoice"
  fileUrl              String
  fileName             String?
  seq                  Int                 @default(0)
  lot                  Lot?                @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lotId                String?
  transactionInvoice   TransactionInvoice? @relation(fields: [transactionInvoiceId], references: [id], onDelete: Cascade)
  transactionInvoiceId String?
  purchaseInvoice      PurchaseInvoice?    @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  purchaseInvoiceId    String?
  createdAt            DateTime            @default(now())

  @@index([lotId])
  @@index([transactionInvoiceId])
  @@index([purchaseInvoiceId])
  @@map("LotDocument")
}

/// A purchase order sent to a co-packer. Creating one also creates its production lot.
model PurchaseOrder {
  id           String              @id @default(cuid())
  orgId        String?
  organization Organization?       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number       String              // e.g. "#21-CRW"
  date         DateTime
  status       String              @default("DRAFT") // DRAFT | SENT
  facility     Facility            @relation(fields: [facilityId], references: [id])
  facilityId   String
  lot          Lot?                @relation(fields: [lotId], references: [id], onDelete: SetNull)
  lotId        String?             @unique
  pdfUrl       String?
  total        Float? // null when any line is TBD
  notes        String?
  imported     Boolean             @default(false) // historical PO from the Drive archive (lot predates it)
  lines        PurchaseOrderLine[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([orgId, number])
}

/// One line on a PO: a SKU being ordered, or a fee (COAs, testing, ...).
model PurchaseOrderLine {
  id          String        @id @default(cuid())
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  poId        String
  seq         Int           @default(0)
  kind        String        @default("SKU") // SKU | FEE
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  description String
  unitCost    Float? // null = TBD (price not agreed yet)
  quantity    Float         @default(0)
  lotUnits    Float? // SKU lines: finished units for the auto-created lot

  @@index([poId])
}

/// One SKU produced within a lot (a lot can produce multiple SKUs).
model LotLine {
  id        String        @id @default(cuid())
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lot       Lot           @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lotId     String
  product   Product       @relation(fields: [productId], references: [id])
  productId String
  units     Float // finished units produced (Float so bulk/weight-based output works)
  seq       Int           @default(0) // stable ordering within a lot
  materials LotMaterial[]

  // ---- Per-SKU lifecycle. SKUs in one lot finish (and get paid for) at different times, so
  // status lives HERE; the lot's status/paymentStatus are derived displays (lib/lot-status.ts).
  status        LotStatus @default(IN_PRODUCTION)
  paymentStatus String    @default("DUE") // PAID | DUE — supplier fully paid for this SKU's run
  finishedAt    DateTime? // set when this SKU flips to FINISHED; cleared if flipped back
  expiryAt      DateTime? // expiry of this SKU's finished goods
  batchNr       String? // production batch number printed on this SKU's finished goods

  // ---- Engine-computed cost snapshot (per unit). Recomputed on data change. ----
  cogPerUnit        Float  @default(0)
  // JSON map of materialCode -> per-unit cost (the authoritative material breakdown).
  materialCostsJson String @default("{}")
  // JSON map of transaction category -> per-unit cost (the authoritative cost breakdown by category).
  transactionCostsJson String @default("{}")
  // JSON array of materials with insufficient stock for this lot (not yet purchased).
  shortfallsJson    String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Bill of materials: how much of a material a lot line consumes per unit.
model LotMaterial {
  id             String       @id @default(cuid())
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lotLine        LotLine      @relation(fields: [lotLineId], references: [id], onDelete: Cascade)
  lotLineId      String
  materialType   MaterialType @relation(fields: [materialTypeId], references: [id])
  materialTypeId String
  perUnit        Float // qty of this material per finished unit (e.g. 15 bags, 1 pouch)
  // For SKU-specific pools, which product's stock to draw (defaults to the line's product).
  product        Product?     @relation(fields: [productId], references: [id])
  productId      String?

  @@unique([lotLineId, materialTypeId])
}

/// One real payment. Fans out into transaction lines that allocate it to lots/SKUs.
model TransactionInvoice {
  id           String        @id @default(cuid())
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  supplierId   String?
  date         DateTime?
  invoiceTotal Float         @default(0) // entered; lines must sum to this
  documentUrl  String? // legacy single-doc field (superseded by documents[])
  documents    Document[]
  lines        Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// A single allocation line of an invoice. category drives whether it hits COG.
model Transaction {
  id                   String              @id @default(cuid())
  orgId                String?
  organization         Organization?       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice              TransactionInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId            String?
  // Per-line lot (transactions survive lot deletion -> become unassigned).
  lot                  Lot?                @relation(fields: [lotId], references: [id], onDelete: SetNull)
  lotId                String?
  date                 DateTime?
  supplier             Supplier?           @relation(fields: [supplierId], references: [id])
  supplierId           String?
  invoiceAmount        Float? // (legacy) — invoice total now lives on TransactionInvoice
  applicableAmount     Float               @default(0) // this line's amount
  category             String              @default("Ingredients") // free-form; see lib/categories.ts
  appliesToCog         Boolean             @default(true) // derived: false when category = NOT_APPLICABLE
  skus                 String? // SKU code, or null = spread proportionally by units
  concept              String?
  invoiceFileUrl       String?
  notApplicableAmount  Float? // legacy (now modeled as a NOT_APPLICABLE line)
  notApplicableConcept String? // legacy
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([lotId])
  @@index([invoiceId])
}

/// One listing (product/variant) in a connected sales channel's catalog — the raw material the
/// mapping screen works from. The actual mapping lives on Product's per-channel identifier
/// columns; this row only remembers what the platform has, plus the founder's "ignore" choice,
/// so disconnect/reconnect restores the exact same picture.
model ChannelListing {
  id                String        @id @default(cuid())
  orgId             String?
  organization      Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel           String // AMAZON | SHOPIFY | TIKTOK (same keys as Facility.channel)
  externalId        String // immutable platform id (Shopify variant gid; Amazon seller SKU)
  externalProductId String? // parent/container id (Shopify product gid; Amazon ASIN)
  sku               String?
  title             String
  imageUrl          String? // platform CDN url — display only, downloaded on import
  price             Float?
  ignored           Boolean       @default(false)
  lastSeenAt        DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([orgId, channel, externalId])
  @@index([orgId, channel, ignored])
}

/// Finished units a sales channel reports holding, per SKU × channel facility. The channel is the
/// source of truth for its own stock, so each sync REPLACES the rows for the facilities it covers
/// rather than adjusting them.
///
/// Amazon deliberately does NOT live here — its stock stays on SkuSnapshot, which carries the
/// richer FBA/AWD split (available / inbound / reserved / unfulfillable) the reorder engine reads.
/// This table is for channels that report a single quantity per warehouse: Shopify and TikTok.
///
/// A facility only exists for warehouses we chose to mirror, which is what keeps Shopify's
/// "Amazon Fulfillment" (MCF) location out: those units are the SAME physical Amazon stock already
/// counted under FBA, and importing them would double-count it.
model ChannelStock {
  id         String   @id @default(cuid())
  orgId      String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  units      Int      @default(0)
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orgId, facilityId, productId])
  @@index([orgId, productId])
  @@index([facilityId])
}

/// A sale pulled from a connected channel — the raw material for velocity and, later, profit.
/// One row per order per channel; `SalesOrderLine` holds its per-SKU quantities and prices.
///
/// Dedup lives at the SOURCE, like the MCF stock rule: a channel that mirrors its orders into
/// Shopify (TikTok is the live example — 32 of Herbl's last 40 Shopify orders came from TikTok)
/// would be counted twice if we took the Shopify copy AND the channel's own copy. So each Shopify
/// order records where it originated (`source`, e.g. "tiktok"/"web"), and Settings.excludedShopifySources
/// lists the sources to drop from Shopify totals — applied at read time, so toggling it needs no
/// re-import. Default empty: Herbl's real TikTok history lives in Shopify today while consl only
/// holds the TikTok sandbox, so nothing is excluded until the real TikTok shop is connected.
model SalesOrder {
  id           String          @id @default(cuid())
  orgId        String?
  organization Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel      String // AMAZON | SHOPIFY | TIKTOK (same keys as Facility.channel roots)
  externalId   String // the platform's own order id — the upsert key, so re-imports don't duplicate
  orderedAt    DateTime
  // Shopify only: which sales channel/app created the order ("web", "tiktok", app handle). The
  // dedup signal. Null for Amazon/TikTok (their whole feed IS that channel).
  source       String?
  sourceLabel  String? // human label for `source` ("Online Store", "TikTok")
  status       String? // platform status; a cancelled/refunded order is kept but flagged out of velocity
  cancelled    Boolean         @default(false)
  // How it was fulfilled, when the platform tells us — drives which stock pool drains later.
  // Amazon: "Amazon" (FBA) | "Merchant". TikTok: "TIKTOK" | "SELLER". Shopify: null (seller-fulfilled).
  fulfillment  String?
  total        Float           @default(0) // order revenue in `currency`, for profit later
  currency     String          @default("USD")
  lines        SalesOrderLine[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([orgId, channel, externalId])
  @@index([orgId, channel, orderedAt])
  @@index([orgId, source])
}

/// One SKU line of a `SalesOrder`. `productId` is the mapped consl product (null when the channel
/// SKU isn't mapped yet — the sale still counts toward channel totals, just not to a product).
model SalesOrderLine {
  id         String     @id @default(cuid())
  orgId      String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  order      SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId  String?
  sku        String? // the channel's SKU as sold, kept even when unmapped
  quantity   Int        @default(0)
  unitPrice  Float      @default(0)
  createdAt  DateTime   @default(now())

  @@index([orgId, productId])
  @@index([orderId])
}
